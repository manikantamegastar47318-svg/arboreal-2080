function selectSpecies(i,open=false){selected=i;const s=species[i];document.getElementById('readCode').textContent=`SPECIMEN ${String(i+1).padStart(3,'0')}`;document.getElementById('readName').textContent=s.name;document.getElementById('readDesc').textContent=s.desc;document.getElementById('mHeight').textContent=s.height;document.getElementById('mRange').textContent=s.range;document.getElementById('mStatus').textContent=s.status;document.getElementById('mEra').textContent=s.era;document.getElementById('bar').style.width=(50+i*8)+'%';rebuild();if(open){document.getElementById('modalName').textContent=s.name;document.getElementById('modalLatin').textContent=s.latin;document.getElementById('modalDesc').textContent=s.desc;document.getElementById('facts').innerHTML=s.facts.map((x,j)=>`<div class="fact"><small>FIELD ${j+1}</small><span>${x}</span></div>`).join('');document.getElementById('modal').classList.add('show')}}
